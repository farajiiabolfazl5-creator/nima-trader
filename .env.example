# ==========================================
# NIMA TRADER - Environment Variables
# ==========================================

# Application
APP_NAME=NimaTrader
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nima_trader
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nima_trader
DB_USER=postgres
DB_PASSWORD=password

# Server
HOST=0.0.0.0
PORT=5000
WORKERS=4

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# APIs - Cryptocurrency
COINGECKO_API_KEY=your-coingecko-api-key
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# APIs - Stock Market
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key
FINHUB_API_KEY=your-finhub-api-key

# Iranian Exchanges
NOBITEX_API_KEY=your-nobitex-api-key
NOBITEX_API_SECRET=your-nobitex-api-secret
WALLEX_API_KEY=your-wallex-api-key
UPBIT_API_KEY=your-upbit-api-key

# Trading Settings
TRADING_ENABLED=True
AUTO_TRADING_ENABLED=False
MAX_TRADE_SIZE=1000
MIN_TRADE_SIZE=10
TRADING_FEE=0.001

# Security
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=86400
API_RATE_LIMIT=1000

# Email (for notifications)
EMAIL_SENDER=noreply@nimatrader.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Currency Conversion
DEFAULT_CURRENCY=USD
SECOND_CURRENCY=EUR

# Feature Flags
ENABLE_CRYPTO_TRADING=True
ENABLE_STOCK_TRADING=True
ENABLE_AUTO_TRADING=True
ENABLE_WITHDRAWAL=True
ENABLE_DEPOSITS=True
